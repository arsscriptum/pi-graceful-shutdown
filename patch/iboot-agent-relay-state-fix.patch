+    /* io/changeRelay with state RELAX IS a shutdown */
     memset(&hdr, 0, sizeof(hdr));
     hdr.command = DXP_CMND_IO;
     hdr.desc = DXP_IO_CHANGE_RELAY;
     ASSERT_MSG(hdr.command == DXP_CMND_IO &&
-               hdr.desc == DXP_IO_CHANGE_RELAY,
-               "io/changeRelay is shutdown");
+               hdr.desc == DXP_IO_CHANGE_RELAY &&
+               DXP_RELAY_RELAX == 2,
+               "io/changeRelay + RELAX is shutdown");
+
+    /* io/changeRelay with state ENERGIZE is NOT a shutdown */
+    ASSERT_MSG(DXP_RELAY_ENERGIZE != DXP_RELAY_RELAX,
+               "io/changeRelay + ENERGIZE is not shutdown");
 
     /* keepAlive should NOT be a shutdown */
