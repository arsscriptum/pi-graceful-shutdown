+    /*
+     * The classifier lives in iboot-agent.c (static). These asserts
+     * mirror its rule so the intended behavior stays documented and
+     * checked. The rule: pcControl halts; changeRelay halts only when
+     * its payload state is RELAX; everything else is ignored. A
+     * changeRelay with state ENERGIZE must NOT halt (the bug that
+     * reset the Pi from a distance).
+     */
+
     /* pcControl should be recognized as shutdown */
     memset(&hdr, 0, sizeof(hdr));
     hdr.command = DXP_CMND_PCCONTROL;
     ASSERT_EQ_INT(hdr.command == DXP_CMND_PCCONTROL, 1,
                   "pcControl is shutdown");
 
